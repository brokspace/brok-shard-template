{
  "name": "brok-shard-template",
  "version": "0.1.0",
  "description": "Reports TODO, FIXME and HACK markers found in changed files",
  "authors": ["Brokspace contributors"],
  "license": "MIT OR Apache-2.0",
  "repository": "https://github.com/brokspace/brok-shard-template",
  "brok": ">=0.1.0, <0.2.0",
  "entrypoint": "bin/brok-shard-template",
  "runtime": "native",
  "permissions": {
    "filesystem": { "read": ["."], "write": [] },
    "network": false
  },
  "subscribes_to": ["file:changed"],
  "publishes_to": ["todo:found"],
  "build": {
    "command": ["cargo", "build", "--release"],
    "artifact": "target/release/brok-shard-template"
  }
}
